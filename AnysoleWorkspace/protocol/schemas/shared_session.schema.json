{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shared.session.v1",
  "type": "object",
  "required": ["schema_version", "session_id", "date", "subject", "camera", "fps", "offset_s", "frame_count", "source_files", "source_hashes"],
  "properties": {
    "schema_version": {"const": "shared.session.v1"},
    "session_id": {"type": "string", "minLength": 1},
    "date": {"type": "string", "pattern": "^[0-9]{8}$"},
    "subject": {"type": "string", "minLength": 1},
    "camera": {"type": "string", "pattern": "^cam[0-9]+$"},
    "fps": {"type": "number", "exclusiveMinimum": 0},
    "offset_s": {"type": "number"},
    "frame_count": {"type": "integer", "minimum": 1},
    "source_files": {"type": "object"},
    "source_hashes": {"type": "object"}
  },
  "additionalProperties": true
}
