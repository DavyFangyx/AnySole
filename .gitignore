# anysole 内的参考实现（半注册 gitlink，本地参考用，不进 git）
/anysole/ReferenceWorks/*/

# Generated artifacts
*.png
*.pkl
*.npy
*.npz
*.bvh
*.csv
*.gif
*.mp4
*.pyc
__pycache__/

# Run logs and model checkpoints
*.log
*.ckpt
*.pt
*.pth

# AnySole is being promoted to the repository root; do not ignore this
# directory while the migration is in progress.

# Centralized baseline data and generated artifacts. Keep only the workspace
# manifest/documentation and management tooling under version control.
/AnysoleWorkspace/**/workspace_cache/

# AnysoleWorkspace v2: raw links and generated facts/representations are
# machine-local outputs. Keep protocol contracts and hand-off reports tracked.
# raw 已数据包化为 AnysoleWorkspace/AnysoleWorkspace/hf-raw/（2026-10-24）；
# AnysoleWorkspace/raw 现为存量相对软链的兼容桥（symlink -> hf-raw），同样不进 git。
/AnysoleWorkspace/raw
/AnysoleWorkspace/assets/upstream/
/AnysoleWorkspace/shared/
/AnysoleWorkspace/model_inputs/
/AnysoleWorkspace/work/
/AnysoleWorkspace/assets/third_party/
/AnysoleWorkspace/reports/*
!/AnysoleWorkspace/reports/*.md
# The repository-wide *.csv rule is intentional for runtime data, but the
# frozen protocol manifest/split files are source contracts and must remain
# visible to git.
!/AnysoleWorkspace/protocol/**/*.csv
!/AnysoleWorkspace/protocol/**/*.jsonl

# Results and visualisation outputs. Keep only the visualisation scripts.
/results/
/results_display/*
!/results_display/README.md
!/results_display/script/

# WandB local runs and runtime outputs/caches
/wandb/
/outputs/
/AnySole/outputs/
/data/hrnet_cache/
/offline_train/queues/

# Offline configs scheduler runtime logs/locks
/configs/*.log

# Offline scheduler task state. Keep the four directories via .gitkeep, but
# never commit generated per-model task confs or old staging artifacts.
/configs/queue/*
!/configs/queue/.gitkeep
/configs/running/*
!/configs/running/.gitkeep
/configs/done/*
!/configs/done/.gitkeep
/configs/failed/*
!/configs/failed/.gitkeep
/configs/logs/
/configs/generated/
# 失败实验的废弃 conf（机器本地归档，不进 git）
/configs/failed_trash/

# Wandb Analyser Thirdparty
/Wandb_Analyzer/

# Large third-party reference repositories.
/ReferenceWorks/RoHM/
/ReferenceWorks/deep-high-resolution-net.pytorch/
/ReferenceWorks/inverse-compositional-STN/
/ReferenceWorks/motion-diffusion-model/

