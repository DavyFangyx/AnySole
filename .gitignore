# Ignore the entire Baselines tree.
Baselines/
# Step2Motion evaluation imports this maintained visualization entry point.
!Baselines/
!Baselines/Step2Motion/
!Baselines/Step2Motion/src/
!Baselines/Step2Motion/src/visualize_compare.py

# Generated artifacts
*.png
*.pkl
*.npy
*.npz
*.bvh
*.csv
*.gif
*.mp4
*.pyc
__pycache__/

# Run logs and model checkpoints
*.log
*.ckpt
*.pt
*.pth

# AnySole is being promoted to the repository root; do not ignore this
# directory while the migration is in progress.

# Centralized baseline data and generated artifacts. Keep only the workspace
# manifest/documentation and management tooling under version control.
/AnysoleWorkspace/dependencies/
/AnysoleWorkspace/derived/
/AnysoleWorkspace/sources/
/AnysoleWorkspace/calibration/
/AnysoleWorkspace/splits/
/AnysoleWorkspace/**/workspace_cache/

# Results and visualisation outputs. Keep only the visualisation scripts.
/results/
/results_display/*
!/results_display/README.md
!/results_display/script/

# WandB local runs and runtime outputs/caches
/wandb/
/outputs/
/AnySole/outputs/
/data/hrnet_cache/
/offline_train/queues/

# Wandb Analyser Thirdparty
/Wandb_Analyzer/

# Large third-party reference repositories.
/ReferenceWorks/RoHM/
/ReferenceWorks/deep-high-resolution-net.pytorch/
/ReferenceWorks/inverse-compositional-STN/
/ReferenceWorks/motion-diffusion-model/
